# Set default behavior to automatically normalize line endings
* text=auto

# Explicit text files with LF line endings
*.lua text eol=lf
*.reds text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows PowerShell scripts
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary files
*.zip binary
*.7z binary
*.png binary
*.jpg binary
